<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quran Voice Tutor — Voice Mode</title>
    <meta name="theme-color" content="#0b0b0b" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="manifest" href="./manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="./icons/favicon.svg" />
    <link rel="stylesheet" href="./theme.css" />
    <link rel="stylesheet" href="./styles/voice-ui.css?v=1762843019" />
    <style>
      body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji"; margin: 0; }
    </style>
    <!-- Settings must load BEFORE bootstrap to ensure ASIMO_SETTINGS is available -->
    <script src="./scripts/settings.js"></script>
    <script src="./scripts/user-auth.js"></script>
    <script src="./scripts/feedback-collector.js"></script>
    <script src="./scripts/bootstrap.js?v=bootstrap5_ios_fix" defer></script>
  </head>
  <body>
    <!-- iOS Audio Unlock (keep for iOS compatibility) -->
    <div id="iosUnlock" role="dialog" aria-modal="true" style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 9999;">
      <button id="btnIosUnlock" style="font-size: 18px; padding: 14px 22px; border-radius: 14px; border: none; background: #3fa8ff; color: #fff; cursor: pointer;">Tap to start audio</button>
    </div>

    <!-- Hidden audio element for TTS playback -->
    <audio id="qvtOut" playsinline autoplay muted hidden></audio>

    <!-- Hidden test elements for compatibility -->
    <span id="muteState" data-testid="muteState" style="display:none">unknown</span>
    <div id="commitWin" data-testid="commit-win" style="display:none"></div>
    <div id="rttEwma" data-testid="rtt-ewma" style="display:none"></div>

    <!-- Settings Gear -->
    <button id="settingsGear" aria-label="Settings">⚙️</button>

    <!-- Settings Panel -->
    <div id="settingsPanel">
      <div class="settings-group">
        <div class="settings-title">Protocol</div>
        <label><input type="checkbox" id="useProtocolV3"> Use Protocol v3 (WebRTC)</label>
      </div>
      <hr>
      <div class="settings-group">
        <div class="settings-title">Voice</div>
        <label><input type="checkbox" id="useServerVAD"> Use server VAD</label>
        <label><input type="checkbox" id="recitationMode"> Recitation mode</label>
      </div>
      <hr>
      <div class="settings-group">
        <div class="settings-title">Audio Feedback</div>
        <label><input type="checkbox" id="audibleFeedback" checked> KB searching beep</label>
        <label><input type="checkbox" id="completionChime" checked> Completion chime</label>
      </div>
      <hr>
      <div class="settings-group">
        <div class="settings-title">Debug</div>
        <label><input type="checkbox" id="autoDownload"> Auto-download audio</label>
      </div>
    </div>

    <!-- Main App -->
    <main id="app">
      <!-- Central Stage -->
      <section id="stage">
        <!-- Breathing Element with Canvas Visualizer -->
        <div id="breather" class="state-idle" role="img" aria-label="Voice status: idle" aria-live="polite">
          <canvas id="viz-canvas" width="320" height="320" aria-hidden="true"></canvas>
          <div id="pulse" aria-hidden="true"></div>
        </div>

        <!-- 4-Button Controls -->
        <div id="controls" role="group" aria-label="Voice controls">
          <button id="btnConnect" class="btn btn-lg btn-green" aria-pressed="false" data-testid="btnConnect">Connect</button>
          <button id="btnMute" class="btn btn-lg" aria-pressed="false" data-testid="btnMute">Mute</button>
          <button id="btnCopyLogs" class="btn" aria-label="Copy all logs to clipboard">Copy Logs</button>
          <button id="btnClearLogs" class="btn" aria-label="Clear all logs">Clear Logs</button>
        </div>
      </section>

      <!-- Transcript and Logs Panes -->
      <section id="panes">
        <div class="pane" id="transcriptPane">
          <h3>Transcript</h3>
          <div id="transcript" role="log" aria-live="polite" aria-atomic="false" data-testid="transcript"></div>
        </div>

        <div class="pane" id="logsPane">
          <h3>Logs</h3>
          <pre id="logs" role="log" aria-live="polite" aria-atomic="false"></pre>
        </div>
      </section>
    </main>

    <!-- "Now Reading" Panel (hidden by default) -->
    <section id="nowReadingPanel" class="now-reading" style="display:none">
      <div class="now-reading-header">
        <h3>📖 Now Reading</h3>
        <button id="btnStopReading" class="btn btn-sm btn-outline" aria-label="Stop reading">Stop</button>
      </div>

      <div class="now-reading-content">
        <div class="book-info">
          <div class="book-title" id="readingTitle">—</div>
          <div class="book-author" id="readingAuthor">—</div>
        </div>

        <div class="section-info">
          <div class="section-header" id="readingSection">—</div>
          <div class="page-progress" id="readingProgress">
            Page <span id="currentPage">—</span> of <span id="totalPages">—</span>
          </div>
        </div>

        <div class="reading-controls" id="readingControls" style="display:none">
          <p class="continuation-prompt">
            Continue with the next <span id="nextPageCount">10</span> pages?
          </p>
          <div class="btn-group">
            <button id="btnContinueReading" class="btn btn-primary">Yes, Continue</button>
            <button id="btnStopAtEnd" class="btn btn-secondary">No, Stop Here</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Load new UI controllers -->
    <script src="./scripts/narration-player.js?v=1763171800"></script>
    <script src="./scripts/visualizer.js?v=1762843019"></script>
    <script src="./scripts/audio-feedback.js?v=1762843019"></script>
    <script src="./scripts/now-reading-panel.js?v=1762843019"></script>
    <script src="./scripts/keyboard-shortcuts.js?v=1762843019"></script>
    <script src="./scripts/ui-controller.js?v=1763174105"></script>
    <script src="./scripts/settings-panel.js?v=1762843019"></script>
  </body>
</html>
